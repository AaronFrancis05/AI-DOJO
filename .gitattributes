# Large binary assets live in Git LFS so every clone and commit doesn't carry
# hundreds of MB of models and video. Clone with git-lfs installed
# (`git lfs install` once per machine). CI fetches them only in the image job.
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
