# Docker:
#   npm run docker:dev   # hot reload (docker-compose.dev.yml)
#   npm run docker:prod  # production build (docker-compose.yml)
#   npm run docker:down  # stop either

# --- Required (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-base-url
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# --- App ---
# PORT=3000
#
# Server-only public site origin (required in production for Neon Auth OAuth redirects).
# Must also be added under Neon Console → Auth → Configuration → Domains.
# APP_ORIGIN=http://localhost:3000
#
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_AVATURN_SUBDOMAIN=

# --- AI (pick via AI_PROVIDER; default gemini) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Optional cache / speech / workers ---
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AUDIO_WORKER_SECRET=
# AVATAR_EXPORT_API_KEY=
# GEMINI_USAGE_LOG=0
# USD_JPY_RATE=150
