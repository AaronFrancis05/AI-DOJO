# Docker:
#   npm run docker:dev   # hot reload (docker-compose.dev.yml)
#   npm run docker:prod  # production build (docker-compose.yml)
#   npm run docker:down  # stop either

# --- Required (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-base-url
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# Who may hold an admin account. Comma-separated addresses; the gate behind the
# unlinked /auth/admin/signup and /auth/admin/signin pages (password and Google).
# Password is checked by POST /api/auth/admin/claim; Google is claimed in the
# OAuth callback. Fails closed: leave it unset and nobody can be promoted to
# admin through those pages (existing admins are unaffected).
ADMIN_EMAILS=

# --- App ---
# PORT=3000
#
# Server-only public site origin (required in production for Neon Auth OAuth redirects).
# Must also be added under Neon Console → Auth → Configuration → Domains.
# APP_ORIGIN=http://localhost:3000
#
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (pick via AI_PROVIDER; default gemini) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# The AI examiner's Gemini Live model (see lib/interview/config.ts). Gemini
# Developer API only — the ephemeral tokens it needs are v1alpha-only and are
# not offered on Vertex. Leave unset for the default.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# Cheaper model for batch generation (study packs, personalized scenarios).
# Each falls back to the provider's main model above when unset. See
# ModelTier in lib/ai-providers/types.ts.
# GEMINI_BATCH_MODEL=gemini-2.5-flash-lite
# ANTHROPIC_BATCH_MODEL=claude-haiku-4-5
# GROQ_BATCH_MODEL=
# AI_BATCH_MODEL=
# AZURE_OPENAI_BATCH_DEPLOYMENT=

# --- Optional cache / speech / workers ---
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AUDIO_WORKER_SECRET=
# AVATAR_EXPORT_API_KEY=
# GEMINI_USAGE_LOG=0
# USD_JPY_RATE=150

# --- Live tutoring (GetStream Cloud Video) ---
# The tutor feature ships dark until these are set AND the flag is on.
# Credentials come from https://dashboard.getstream.io -> your Video app.
# VIDEO ONLY: never add a GetStream Chat key here. Text chat — including the
# sidebar inside a live room — is served by this project's own chat_rooms
# tables with UgaJapa translation, which is what keeps Stream Chat's separate
# (and far more expensive) contract off the bill.
# NEXT_PUBLIC_* is baked into the browser bundle at `next build`.
# `docker compose up --build` passes these as build-args from this file.
# Changing them later needs a rebuild — runtime env_file is not enough.
# NEXT_PUBLIC_TUTORS_ENABLED=1
# NEXT_PUBLIC_STREAM_API_KEY=
# Anyone holding the secret can mint a token for any call. Server-side only.
# STREAM_API_SECRET=

# --- Personalized learning (PLAN.md Phase 3) ---
# Study packs after each session, the weak-point model, and learner-owned
# scenarios. Off: sessions complete exactly as before, no session/completed
# event is sent, and no batch AI cost is incurred. Needs migration 0058 and a
# reachable Inngest (INNGEST_EVENT_KEY in production, `npx inngest-cli dev`
# locally). NEXT_PUBLIC_* is baked in at `next build`.
# NEXT_PUBLIC_STUDY_PACKS_ENABLED=1
